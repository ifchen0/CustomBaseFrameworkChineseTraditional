  <CBF_Tend_StronglyPreferred>強烈偏好</CBF_Tend_StronglyPreferred>
  <!-- EN: Required -->
  <CBF_Tend_Required>必需</CBF_Tend_Required>
  <!-- EN: The town wall docks here. A gatehouse needs at least two cells of it. -->
  <CBF_AnchorConnect_Wall>城牆在此對接。門樓至少需要兩格這樣的錨點。</CBF_AnchorConnect_Wall>
  <!-- EN: Shows which side of the piece faces outward. A gatehouse needs it, otherwise the generator turns the gate the wrong way round. -->
